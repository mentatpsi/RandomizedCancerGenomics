def bezier(p0, p1, pull=0.25, n=40):
    # Quadratic curve bowed toward the centre, as in a chord diagram
    c = (p0 + p1) / 2 * pull
    t = np.linspace(0, 1, n)[:, None]
    return (1 - t) ** 2 * p0 + 2 * (1 - t) * t * c + t ** 2 * p1


